# Copie para .env no seu servidor (nunca versione o .env real)
PORT=8000

# Caminho do bancoSQLite (padrao: ./plataformavenda.db)
# PV_DB_PATH=/app/data/plataformavenda.db

# Chave-mestra que criptografa as credenciais das integracoes (WhatsApp/MP/SMTP)
# no banco de dados. Gere uma forte:  python3 -c "import secrets; print(secrets.token_hex(32))"
PV_MASTER_KEY=troque-por-uma-chave-forte-e-secreta

# URL publica canonica. Use SEMPRE em producao: e ela que aparece nos links de
# redefinicao de senha, nos webhooks e nas back_urls de pagamento (sem depender
# do header Host da requisicao).
# PV_PUBLIC_URL=https://seudominio.com.br

# Limite de tamanho do corpo das requisicoes em bytes (padrao: 8 MB)
# PV_MAX_BODY_BYTES=8388608

# Apenas para desenvolvimento local sem SMTP: exibe o link de redefinicao de
# senha na resposta da API. NUNCA ative em producao.
# PV_ALLOW_RESET_LINK=1
